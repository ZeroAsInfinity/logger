{
  "name": "logger",
  "version": "1.0.8",
  "description": "Adaptive TypeScript logger/debugger with optional Grok-powered insight and runtime adaptation.",
  "license": "MIT",
  "author": "Sam Pearson and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeroAsInfinity/logger.git"
  },
  "bugs": {
    "url": "https://github.com/ZeroAsInfinity/logger/issues"
  },
  "homepage": "https://github.com/ZeroAsInfinity/logger#readme",
  "type": "commonjs",
  "main": "dist/samiam.js",
  "types": "dist/samiam.d.ts",
  "exports": {
    ".": {
      "types": "./dist/samiam.d.ts",
      "require": "./dist/samiam.js",
      "default": "./dist/samiam.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logger",
    "typescript",
    "debugger",
    "observability",
    "grok"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "smoke": "jest --runInBand tests/samiam.test.ts",
    "simulate:live": "npm run build && node scripts/live-simulation.js",
    "test:ci": "npm run typecheck && npm run test:coverage",
    "verify": "npm run build && npm run test:ci",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.31",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
